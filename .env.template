# =============================================================================
# MGR CAPITAL ASSISTANCE — Environment Configuration Template
# Copy this file to .env and configure all values before deployment
#
# SECURITY WARNING: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=mgr_capital
DB_HOST=db
DB_PORT=5432

# Full connection URL (used by Prisma)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# HTTP/HTTPS ports for nginx
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# JWT Authentication (REQUIRED - Generate secure random values!)
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET_FOR_REFRESH
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=14

# Legacy (for backwards compatibility)
JWT_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# Cookie Configuration
# -----------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - set REDIS_ENABLED=true to use)
# -----------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
CACHE_DEFAULT_TTL=3600

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
BATCH_SIZE_LIMIT=1000
QUERY_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Backup Configuration
# Generate passphrase with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_ENCRYPTION_KEY
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable air-gap mode (disables external connections)
AIR_GAP_MODE=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://localhost

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_TRAINING_MODULE=true
ENABLE_CLIENT_PORTAL=true
ENABLE_SCRAPER=false
