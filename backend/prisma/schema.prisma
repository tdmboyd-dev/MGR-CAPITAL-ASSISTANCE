enum OpsInsightType {
  INGESTION_ANALYSIS
  PAYOUT_ANALYSIS
  COMPLIANCE_CHECK
  TRAINING_ANALYSIS
  COORDINATOR_SUMMARY
  CASE_RECOMMENDATION
  EMPLOYEE_COACHING
  SYSTEM_HEALTH
  BOT_PERFORMANCE
  FEEDBACK_ANALYSIS
}

enum OpsInsightPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model OpsInsight {
  id              String              @id @default(cuid())
  type            OpsInsightType?
  priority        OpsInsightPriority  @default(NORMAL)
  source          String?             // Source of insight
  category        String?             // Category for grouping
  severity        String?             // INFO, LOW, MEDIUM, HIGH, CRITICAL
  status          String              @default("OPEN")
  description     String?             @db.Text
  data            Json?               // Raw data blob
  actionRequired  Boolean             @default(false)

  // Multi-tenant support
  tenantId        String?
  tenant          Tenant?             @relation(fields: [tenantId], references: [id])

  // Content
  title           String?
  summary         String?             @db.Text
  details         Json?               // Structured data

