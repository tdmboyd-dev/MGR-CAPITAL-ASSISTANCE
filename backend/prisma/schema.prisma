// ============================================
// WHITE-LABEL PARTNER SYSTEM
// Session 32: 4-Tier Partner Hierarchy
// MGR Capital → Managing Partner → Executive Partner → Recovery Director → Recovery Specialist
// ============================================

// 4-Tier Partner Hierarchy
enum PartnerLevel {
  MANAGING_PARTNER      // Level 1: $999/mo - Regional leaders, unlimited downline
  EXECUTIVE_PARTNER     // Level 2: $499/mo - Can have Recovery Directors
  RECOVERY_DIRECTOR     // Level 3: $199/mo - Can have Recovery Specialists
  RECOVERY_SPECIALIST   // Level 4: $49/mo  - Serves clients directly
}

// Legacy tier for backwards compatibility
enum WhiteLabelTier {
  STARTER       // Maps to RECOVERY_SPECIALIST
  PROFESSIONAL  // Maps to RECOVERY_DIRECTOR
  ENTERPRISE    // Maps to MANAGING_PARTNER
}

enum WhiteLabelApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
  SUSPENDED
}

model WhiteLabelApplication {
  id                  String                       @id @default(cuid())
  userId              String
  companyName         String
  companyWebsite      String?
  businessLicense     String?
  einNumber           String?
  contactName         String
  contactEmail        String
  contactPhone        String
  tier                WhiteLabelTier
  billingCycle        String                       // monthly, yearly
  status              WhiteLabelApplicationStatus  @default(PENDING)
  submittedAt         DateTime                     @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  rejectionReason     String?
  approvedAt          DateTime?
  activatedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
}

model WhiteLabelConfig {
  id                  String          @id @default(cuid())
  userId              String          @unique
  companyName         String
  tier                WhiteLabelTier  // Legacy tier
  partnerLevel        PartnerLevel?   // 4-tier partner level

  // Branding
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String          @default("#1a365d")
  secondaryColor      String          @default("#2d3748")
  accentColor         String          @default("#3182ce")

  // Custom Domain (Recovery Director+ levels)
  customDomain        String?         @unique
  domainVerified      Boolean         @default(false)
  sslCertificateId    String?

  // Custom Email (Recovery Director+ levels)
  emailDomain         String?
  supportEmail        String?

  // Billing - 11 month cycle, bill 1 month early for renewal
  billingCycle        String          // monthly, yearly
  nextBillingDate     DateTime
  priceCents          Int

  // 4-Tier Hierarchy
  parentPartnerId     String?         // Direct parent in hierarchy
  parentPartner       WhiteLabelConfig? @relation("PartnerTree", fields: [parentPartnerId], references: [id])
  downline            WhiteLabelConfig[] @relation("PartnerTree")
  hierarchyDepth      Int             @default(4)  // 1=MP, 2=EP, 3=RD, 4=RS
  maxDownline         Int             @default(0)  // Max direct reports allowed

  // Revenue sharing - Fee labels hide the real split
  // What partner SEES - labeled as "Processing Fees", "Filing Fees", etc.
  displayedFeePercent Int             @default(45)  // Recovery Specialist default
  displayedFeeLabel   String          @default("Processing & Document Fees")
  // What partner ACTUALLY gets
  actualTakeHomePercent Int           @default(45)
  // Hidden upline cut (partner never sees this)
  hiddenUplineCut     Int             @default(10)

  // Earnings tracking
  lifetimeGrossCents            Int   @default(0)  // Total before "fees"
  lifetimeDisplayedFeesCents    Int   @default(0)  // What partner sees as fees
  lifetimeNetCents              Int   @default(0)  // What partner received
  lifetimeHiddenUplineCents     Int   @default(0)  // FOUNDER ONLY: Upline cuts
  lifetimeHomeOfficeCents       Int   @default(0)  // FOUNDER ONLY: MGR Capital take

  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId])
  @@index([tier])
  @@index([partnerLevel])
  @@index([isActive])
  @@index([customDomain])
  @@index([parentPartnerId])
  @@index([hierarchyDepth])
}

// ============================================
// CERTIFIED NOTARY SYSTEM
// Session 32: Internal notary workforce
// Notaries see "Processing & Compliance Fees"
// ============================================

enum NotaryApplicationStatus {
  PENDING
  DOCUMENTS_REQUIRED
  TRAINING_REQUIRED
  BACKGROUND_CHECK
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum NotaryLevel {
  ASSOCIATE_NOTARY      // 0+ signings: 45% net after "fees"
  CERTIFIED_NOTARY      // 10+ signings: 48% net
  SENIOR_NOTARY         // 50+ signings: 50% net
  LEAD_NOTARY           // 200+ signings: 52% net
  EXECUTIVE_NOTARY      // 500+ signings: 55% net
}

model NotaryApplication {
  id                      String                    @id @default(cuid())
  userId                  String
  state                   String
  status                  NotaryApplicationStatus   @default(PENDING)

  // Notary commission info
  commissionNumber        String?
  commissionExpiration    DateTime?
  bondNumber              String?
  eoInsurancePolicyNumber String?

  // Training completion
  trainingCompleted       Boolean                   @default(false)
  trainingCompletedAt     DateTime?
  examPassed              Boolean?
  examScore               Int?

  // Background check
  backgroundCheckCompleted Boolean                  @default(false)
  backgroundCheckResult   String?                   // pass, fail, pending

  // Certification
  certified               Boolean                   @default(false)
  certificationDate       DateTime?

  submittedAt             DateTime                  @default(now())
  approvedAt              DateTime?
  rejectedReason          String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([userId])
  @@index([state])
  @@index([status])
}

model NotaryProfile {
  id                    String        @id @default(cuid())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id])
  state                 String
  commissionNumber      String
  commissionExpiration  DateTime
  level                 NotaryLevel   @default(ASSOCIATE_NOTARY)
  totalSignings         Int           @default(0)

  // Earnings tracking - notary sees "Processing & Compliance Fees"
  // They never see the word "platform" or know where fees go
  lifetimeGrossCents            Int   @default(0)   // Total before fees
  lifetimeDisplayedFeesCents    Int   @default(0)   // "Processing & Compliance Fees"
  lifetimeNetCents              Int   @default(0)   // What notary received
  // FOUNDER ONLY - never exposed to notary
  lifetimeHomeOfficeCents       Int   @default(0)   // What MGR Capital kept
  displayedFeeLabel             String @default("Processing & Compliance Fees")

  // This month
  monthlyGrossCents             Int   @default(0)
  monthlyFeesCents              Int   @default(0)   // Labeled as professional fees
  monthlyNetCents               Int   @default(0)
  monthlyHomeOfficeCents        Int   @default(0)   // FOUNDER ONLY

  // Performance
  averageRating         Float       @default(0)
  completionRate        Float       @default(100)

  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([state])
  @@index([level])
  @@index([isActive])
}

model NotarySessionRecord {
  id                    String    @id @default(cuid())
  notaryId              String
  clientName            String
  clientEmail           String
  clientPhone           String?
  documentType          String
  sessionType           String    // standard, expedited, priority, loan_signing, complex
  status                String    @default("scheduled")
  caseId                String?

  scheduledTime         DateTime
  startedAt             DateTime?
  completedAt           DateTime?

  // Pricing - notary sees "Processing & Compliance Fees"
  grossAmountCents      Int       // Total client pays
  displayedFeeCents     Int       // Labeled as "Processing & Compliance Fees"
  netToNotaryCents      Int       // What notary receives
  // FOUNDER ONLY
  homeOfficeTakeCents   Int       // MGR Capital's actual take (hidden)
  feeLabel              String    @default("Processing & Compliance Fees")

  // Recording (required for RON compliance)
  videoRecordingUrl     String?
  auditLogUrl           String?

  // Feedback
  rating                Int?
  feedback              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([notaryId])
  @@index([status])
  @@index([scheduledTime])
  @@index([caseId])
  @@index([completedAt])
}

// ============================================
// WATCH TARGETS (Scraper Monitoring)
