enum SystemErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model SystemError {
  id              String               @id @default(cuid())
  message         String
  stack           String?              @db.Text
  context         Json?                // Request context, user info, etc.
  severity        SystemErrorSeverity  @default(ERROR)

  // Source info
  source          String?              // Service/route that generated error
  endpoint        String?              // API endpoint if applicable

  // User context
  userId          String?
  ipAddress       String?
  userAgent       String?

  // Resolution
  isResolved      Boolean              @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?              @db.Text

  createdAt       DateTime             @default(now())

  @@index([severity])
  @@index([source])
  @@index([isResolved])
  @@index([createdAt])
}

model NotificationLog {
  id              String              @id @default(cuid())
  type            NotificationType
  status          NotificationStatus  @default(PENDING)

  // Recipient
  toAddress       String              // Email, phone, or user ID
  toName          String?

  // Content
  subject         String?
  bodyPreview     String?             // First 200 chars
  bodyFull        String?             @db.Text

  // Related entities
  relatedCaseId   String?
  relatedUserId   String?

  // Delivery info
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  errorMessage    String?

  // External refs
  externalId      String?             // ID from email provider

  createdAt       DateTime            @default(now())

  @@index([type])
  @@index([status])
  @@index([relatedCaseId])
  @@index([relatedUserId])
  @@index([createdAt])
}

// ============================================
// TRAINING MODULE DETAILS & ASSET PLANS
