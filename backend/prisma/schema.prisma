// ============================================

model ProfessionalEmail {
  id                String    @id @default(cuid())
  userId            String
  emailAddress      String    @unique
  displayName       String
  plan              String    // basic, professional, premium
  status            String    @default("active") // pending, active, suspended, cancelled
  provider          String    // zoho, improvmx, google, microsoft, demo
  forwardTo         String?   // Forward email address
  monthlyPriceCents Int
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([emailAddress])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
