generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  FOUNDER
  ADMIN
  EMPLOYEE
  CLIENT
  HR
  COMPLIANCE
  TEAM_LEAD
}

enum CaseStatus {
  NEW
  CONTACTED
  DOCS_PENDING
  DOCS_SIGNED
  FILED
  AWAITING_FUNDS
  PAID
  CLOSED
  REJECTED
}

enum EmployeeTier {
  TIER_1_ASSOCIATE
  TIER_2_SPECIALIST
  TIER_3_SENIOR_SPECIALIST
  TIER_4_TEAM_LEADER
  TIER_5_EXECUTIVE_PARTNER
}

enum DocumentType {
  CLIENT_SERVICE_AGREEMENT
  LIMITED_POA
  AFFIDAVIT
  MOTION
  COVER_LETTER
  FILING_PACKET
  EVIDENCE_PACKET
  FOLLOW_UP_LETTER
  VERIFICATION_LETTER
  PAYMENT_INSTRUCTIONS
  CLIENT_ID
  PROPERTY_DEED
  TAX_RECORD
  OTHER
}

enum DocumentStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  SUBMITTED
  APPROVED
  REJECTED
}

enum LedgerEntryType {
  COMMISSION
  EMPLOYEE_COMMISSION
  OVERRIDE
  FOUNDER_SHARE
  CLIENT_PAYOUT
  COMPANY_FEE
  ADJUSTMENT
  REFUND
  FEE
}

enum CommunicationType {
  CALL
  TEXT
  EMAIL
  PORTAL_MESSAGE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum TrainingModuleStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum TrainingModuleSourceType {
  STATIC
  OPS_INSIGHT
  SCRAPED_ITEM
  CLAIM_PATTERN
  COMPLIANCE_UPDATE
  JURISDICTION_CHANGE
  INGESTION_PATTERN      // Auto-generated from ingestion error patterns
  PARSER_SUGGESTION      // Generated when parser improvements suggested
}

enum TrainingRecommendationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  MANDATORY
}

enum TrainingRecommendationReason {
  LOW_CONVERSION
  MISSING_SKILLS
  TIER_REQUIREMENT
  COMPLIANCE_GAP
  JURISDICTION_UPDATE
  NEW_HIRE
  PERFORMANCE_DECLINE
  SKILL_REFRESH
  PROMOTION_PATH
}

enum TierProgressionStatus {
  NOT_ELIGIBLE
  IN_PROGRESS
  REQUIREMENTS_MET
  PENDING_REVIEW
  APPROVED
  DENIED
}

enum IngestionSourceType {
  TAX_SALE_LIST
  SURPLUS_PDF
  AUCTION_RESULT
  COUNTY_WEBSITE
  MANUAL_ENTRY
}

// ============================================
// OPS LAYER ENUMS
// ============================================

enum ScrapedItemType {
  TAX_SALE_LIST
  SURPLUS_RULES
  COURT_NOTICE
  COUNTY_WEBSITE
  STATE_STATUTE
  DOCUMENT_PATTERN
}

enum ScrapedItemReviewStatus {
  PENDING
  REVIEWED
  ACTIONABLE
  DISMISSED
  ARCHIVED
}

enum WatchAlertType {
  RULE_CHANGE_DETECTED
  NEW_DOCUMENT_PATTERN
  DEADLINE_PATTERN_CHANGE
  HIGH_RISK_INGESTION
  PAYOUT_ANOMALY
  EMPLOYEE_ANOMALY
  JURISDICTION_VOLATILITY
  SYSTEM_HEALTH
}

enum WatchAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String
  role                UserRole
  name                String
  phone               String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  isActive            Boolean      @default(true)
  emailVerified       Boolean      @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Employee-specific fields
  employeeTier        EmployeeTier?
  hireDate            DateTime?
  teamLeaderId        String?
  teamLeader          User?        @relation("TeamMembers", fields: [teamLeaderId], references: [id])
  teamMembers         User[]       @relation("TeamMembers")
  trainingCompleted   Boolean      @default(false)

  // Client-specific fields
  ssn4                String?      // Last 4 digits only, encrypted
  dateOfBirth         DateTime?

  // Relations
  assignedCases       Case[]       @relation("AssignedEmployee")
  clientCases         Case[]       @relation("ClientCases")
  ledgerEntries       LedgerEntry[]
  communications      Communication[]
  documents           Document[]   @relation("UploadedBy")
  trainingProgress    EmployeeTrainingProgress[]
  callScores          CallScore[]
  sessions            UserSession[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
  chatMessages        ChatMessage[]

  @@index([email])
  @@index([role])
  @@index([employeeTier])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================
// REFRESH TOKENS — JWT HARDENING
// Secure refresh token storage with rotation
// ============================================

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken   String    // SHA256 hash of raw token
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  rotatedAt     DateTime? // When this token was rotated to a new one
  replacedById  String?   // ID of the token that replaced this one
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([hashedToken])
  @@index([expiresAt])
}

// ============================================
// CASE MANAGEMENT
// ============================================

model Case {
  id                    String       @id @default(cuid())
  internalCode          String       @unique
  publicAccessToken     String       @unique @default(cuid())
  status                CaseStatus   @default(NEW)

  // Client info
  clientId              String
  client                User         @relation("ClientCases", fields: [clientId], references: [id])

  // Assigned employee
  assignedEmployeeId    String?
  assignedEmployee      User?        @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])

  // Property info
  state                 String
  county                String
  propertyAddress       String
  parcelNumber          String?
  saleDate              DateTime?
  previousOwner         String?

  // Financials (all in cents to avoid floating point)
  surplusAmountCents    Int          // FOUNDER ONLY - Never expose
  feePercent            Int          // Company fee percentage (e.g., 30 = 30%)
  estimatedFeeCents     Int?         // Calculated fee amount
  actualFeeCents        Int?         // Final fee received
  clientPayoutCents     Int?         // Amount paid to client

  // Legal tracking
  redemptionDeadline    DateTime?
  filingDeadline        DateTime?
  claimNumber           String?
  courtCaseNumber       String?

  // Status timestamps
  contactedAt           DateTime?
  docsRequestedAt       DateTime?
  docsSignedAt          DateTime?
  filedAt               DateTime?
  fundsReceivedAt       DateTime?
  fundsDisbursedAt      DateTime?
  paidAt                DateTime?
  closedAt              DateTime?

  // Metadata
  source                String?      // Where lead came from
  priority              Int          @default(0) // Higher = more priority
  notes                 String?      // Internal notes (founder only)
  rejectionReason       String?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  documents             Document[]
  communications        Communication[]
  ledgerEntries         LedgerEntry[]
  deadlines             Deadline[]
  stateRule             StateRule?   @relation(fields: [state], references: [stateCode])
  countyRule            CountyRule?  @relation(fields: [state, county], references: [stateCode, countyName])

  @@index([status])
  @@index([state])
  @@index([county])
  @@index([assignedEmployeeId])
  @@index([clientId])
  @@index([publicAccessToken])
  // Performance indexes (compound for hot queries)
  @@index([status, assignedEmployeeId, createdAt(sort: Desc)])
  @@index([state, county])
  @@index([status, createdAt(sort: Desc)])
}

model Deadline {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime
  reminderSent  Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([caseId])
  @@index([dueDate])
}

// ============================================
// DOCUMENTS
// ============================================

model Document {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            DocumentType
  status          DocumentStatus @default(DRAFT)

  // File info
  fileName        String
  filePath        String?          // Local storage path (relative)
  fileUrl         String           // Can be local path or external URL
  fileSize        Int
  mimeType        String

  // Generation info
  templateId      String?
  template        DocumentTemplate? @relation(fields: [templateId], references: [id])
  generatedContent String?        @db.Text

  // Signatures
  signatureRequired Boolean      @default(false)
  signedAt          DateTime?
  signatureUrl      String?

  // Tracking
  uploadedById    String
  uploadedBy      User           @relation("UploadedBy", fields: [uploadedById], references: [id])
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([caseId])
  @@index([type])
  @@index([status])
}

model DocumentTemplate {
  id              String       @id @default(cuid())
  type            DocumentType @unique
  name            String
  description     String?
  content         String       @db.Text  // Template with placeholders
  requiredFields  String[]     // List of required placeholder fields
  stateSpecific   Boolean      @default(false)
  state           String?      // If state-specific
  isActive        Boolean      @default(true)
  version         Int          @default(1)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  documents       Document[]

  @@index([type])
  @@index([state])
}

// ============================================
// LEGAL RULES ENGINE
// ============================================

model StateRule {
  id                      String       @id @default(cuid())
  stateCode               String       @unique  // e.g., "TN", "GA"
  stateName               String

  // Surplus fund rules
  surplusFundLaw          String       @db.Text  // Statute reference
  claimPeriodDays         Int          // How long to file claim
  redemptionPeriodDays    Int?         // Redemption period if applicable
  interestRate            Float?       // Interest rate on surplus

  // Filing requirements
  requiredDocuments       DocumentType[]
  filingFee               Int?         // In cents
  filingMethod            String       // "mail", "electronic", "in-person"
  filingAddress           String?

  // Deadlines
  deadlineCalculation     String       @db.Text  // How to calculate deadlines

  // Special rules
  specialRequirements     String?      @db.Text
  restrictions            String?      @db.Text

  // Metadata
  lastVerified            DateTime?
  sourceUrl               String?
  notes                   String?      @db.Text

  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  counties                CountyRule[]
  cases                   Case[]

  @@index([stateCode])
}

model CountyRule {
  id                      String       @id @default(cuid())
  stateCode               String
  state                   StateRule    @relation(fields: [stateCode], references: [stateCode])
  countyName              String

  // County-specific overrides
  clerkName               String?
  clerkPhone              String?
  clerkEmail              String?
  clerkAddress            String?

  // Filing specifics
  localFilingFee          Int?         // Override state fee if different
  localFilingMethod       String?      // Override state method
  localRequirements       String?      @db.Text

  // Deadlines
  localDeadlineVariation  Int?         // Days +/- from state deadline

  // Special notes
  notes                   String?      @db.Text

  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  cases                   Case[]

  @@unique([stateCode, countyName])
  @@index([stateCode])
}

// ============================================
// FINANCIAL / LEDGER
// ============================================

enum LedgerEntryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model LedgerEntry {
  id                    String            @id @default(cuid())
  caseId                String
  case                  Case              @relation(fields: [caseId], references: [id])
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id])

  type                  LedgerEntryType
  amountCents           Int
  displayedAmountCents  Int?              // For shadow accounting - what employee sees
  description           String
  status                LedgerEntryStatus @default(PENDING)

  // For commission entries
  tierAtTime            EmployeeTier?     // Employee tier when earned
  displayedRate         Int?              // What employee sees (e.g., 60)
  actualRate            Int?              // Real rate (e.g., 30)

  // Payout tracking
  isPaid                Boolean           @default(false)
  paidAt                DateTime?
  paymentMethod         String?
  paymentRef            String?

  // Completion tracking
  completedAt           DateTime?
  reference             String?           // External reference (check #, wire ref, etc.)
  notes                 String?           // Admin notes

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([caseId])
  @@index([userId])
  @@index([type])
  @@index([isPaid])
  @@index([status])
  // Performance indexes (compound for hot queries)
  @@index([type, status, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
}

model CommissionPlan {
  id                    String       @id @default(cuid())
  tier                  EmployeeTier @unique
  tierDisplayName       String       // "Tier 1 — Associate"

  // Shadow accounting
  displayedRatePercent  Int          // What employee sees (e.g., 20, 40, 60, 80, 100)
  actualRatePercent     Int          // What they actually get (e.g., 10, 20, 30, 40, 50)

  // Override for team leaders
  overridePercent       Int?         // Override on team members' deals

  // Promotion requirements
  casesRequired         Int?         // Cases needed for next tier
  revenueRequired       Int?         // Revenue in cents needed
  trainingRequired      Boolean      @default(true)

  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

// ============================================
// COMMUNICATION
// ============================================

model Communication {
  id              String                 @id @default(cuid())
  caseId          String
  case            Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id])

  type            CommunicationType
  direction       CommunicationDirection

  // Content
  subject         String?
  content         String                 @db.Text

  // For calls
  duration        Int?                   // In seconds
  recordingUrl    String?

  // For emails/texts
  toAddress       String?
  fromAddress     String?

  // Script used (if applicable)
  scriptId        String?
  script          Script?                @relation(fields: [scriptId], references: [id])

  // Outcome
  outcome         String?
  nextAction      String?

  createdAt       DateTime               @default(now())

  @@index([caseId])
  @@index([userId])
  @@index([type])
}

model Script {
  id              String            @id @default(cuid())
  name            String
  type            CommunicationType
  caseStatus      CaseStatus        // Which stage this script is for

  content         String            @db.Text

  // Compliance
  complianceNotes String?           @db.Text
  prohibitedWords String[]          // Words that should never be used
  requiredPhrases String[]          // Phrases that must be included

  isActive        Boolean           @default(true)
  version         Int               @default(1)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  communications  Communication[]

  @@index([type])
  @@index([caseStatus])
}

model CallScore {
  id              String   @id @default(cuid())
  employeeId      String
  employee        User     @relation(fields: [employeeId], references: [id])

  // Scoring
  clarityScore    Int      // 1-10
  complianceScore Int      // 1-10
  toneScore       Int      // 1-10
  effectivenessScore Int   // 1-10
  overallScore    Int      // Calculated average

  // Feedback
  feedback        String?  @db.Text
  coachingNotes   String?  @db.Text

  // Recording reference
  recordingUrl    String?

  createdAt       DateTime @default(now())

  @@index([employeeId])
}

// ============================================
// TRAINING
// ============================================

model TrainingModule {
  id              String                    @id @default(cuid())
  title           String
  description     String                    @db.Text
  content         String                    @db.Text  // Full training content

  // Ordering
  orderIndex      Int

  // Requirements
  requiredForTier EmployeeTier?             // Minimum tier that needs this
  prerequisites   String[]                  // IDs of modules that must be completed first

  // Assessment
  hasQuiz         Boolean                   @default(false)
  passingScore    Int?                      // Percentage needed to pass

  // Source type (for dynamic vs static modules)
  sourceType      TrainingModuleSourceType  @default(STATIC)
  sourceId        String?                   // Reference to source if dynamic
  sourceSummary   String?                   @db.Text

  // Target audience for dynamic modules
  targetStates    String[]                  // If jurisdiction-specific

  isActive        Boolean                   @default(true)
  isMandatory     Boolean                   @default(false)
  isCertification Boolean                   @default(false)
  version         Int                       @default(1)

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  expiresAt       DateTime?                 // For time-limited modules

  progress        EmployeeTrainingProgress[]
  questions       TrainingQuestion[]

  @@index([orderIndex])
  @@index([sourceType])
  @@index([requiredForTier])
}

model TrainingQuestion {
  id              String          @id @default(cuid())
  moduleId        String
  module          TrainingModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  question        String          @db.Text
  options         String[]        // Multiple choice options
  correctAnswer   Int             // Index of correct option
  explanation     String?         @db.Text

  orderIndex      Int

  createdAt       DateTime        @default(now())

  @@index([moduleId])
}

model EmployeeTrainingProgress {
  id              String                @id @default(cuid())
  employeeId      String
  employee        User                  @relation(fields: [employeeId], references: [id])
  moduleId        String
  module          TrainingModule        @relation(fields: [moduleId], references: [id])

  status          TrainingModuleStatus  @default(LOCKED)
  progress        Int                   @default(0)  // Percentage complete

  // Quiz results
  quizAttempts    Int                   @default(0)
  bestScore       Int?
  passedAt        DateTime?

  // Tracking
  startedAt       DateTime?
  completedAt     DateTime?
  deadline        DateTime?             // When this module must be completed

  // Assignment
  assignedBy      String?               // "system", "trainingBot", or userId
  assignedAt      DateTime              @default(now())

  // Priority
  priority        TrainingRecommendationPriority @default(NORMAL)
  isMandatory     Boolean               @default(false)

  @@unique([employeeId, moduleId])
  @@index([employeeId])
  @@index([moduleId])
  @@index([deadline])
  @@index([status])
}

// ============================================
// TRAINING INTELLIGENCE — RECOMMENDATIONS
// Personalized training recommendations per employee
// ============================================

model TrainingRecommendation {
  id              String                          @id @default(cuid())
  employeeId      String
  moduleId        String?                         // Null if recommending a new topic

  // Recommendation details
  reason          TrainingRecommendationReason
  priority        TrainingRecommendationPriority  @default(NORMAL)
  mandatory       Boolean                         @default(false)

  // Content
  title           String
  description     String                          @db.Text
  estimatedDuration Int?                          // Minutes

  // Deadline
  dueDate         DateTime?

  // Status
  isAccepted      Boolean                         @default(false)
  acceptedAt      DateTime?
  isCompleted     Boolean                         @default(false)
  completedAt     DateTime?
  isDismissed     Boolean                         @default(false)
  dismissedAt     DateTime?
  dismissedReason String?

  // Source tracking
  sourceBot       String?                         // "trainingBot", etc.
  sourceInsightId String?                         // If generated from OpsInsight

  createdAt       DateTime                        @default(now())
  expiresAt       DateTime?

  @@index([employeeId])
  @@index([moduleId])
  @@index([priority])
  @@index([isCompleted])
}

// ============================================
// TRAINING INTELLIGENCE — DYNAMIC MODULES
// Auto-generated modules from OpsInsight/ScrapedItem
// ============================================

model DynamicTrainingModule {
  id              String                    @id @default(cuid())

  // Module content
  title           String
  description     String                    @db.Text
  content         Json                      // DynamicModuleContent structure

  // Source
  sourceType      TrainingModuleSourceType
  sourceId        String?                   // OpsInsight ID, ScrapedItem ID, etc.
  sourceSummary   String?                   @db.Text

  // Target audience
  targetRoles     UserRole[]
  targetTiers     EmployeeTier[]
  targetStates    String[]
  targetAll       Boolean                   @default(false)

  // Quiz
  quizQuestions   Json?                     // Array of DynamicQuizQuestion
  passingScore    Int                       @default(80)

  // Metadata
  estimatedDuration Int                     @default(30)  // Minutes
  isActive        Boolean                   @default(true)
  version         Int                       @default(1)

  // Validity
  expiresAt       DateTime?

  // Stats
  assignedCount   Int                       @default(0)
  completedCount  Int                       @default(0)
  avgScore        Int?

  generatedBy     String                    // "trainingBot", "system"
  generatedAt     DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([sourceType])
  @@index([isActive])
  @@index([generatedAt])
}

// ============================================
// TRAINING INTELLIGENCE — TIER PROGRESSION
// Track tier advancement evaluations
// ============================================

model TierProgressionLog {
  id              String                @id @default(cuid())
  employeeId      String

  // Tiers
  fromTier        EmployeeTier
  toTier          EmployeeTier

  // Status
  status          TierProgressionStatus @default(IN_PROGRESS)

  // Requirements snapshot
  requirements    Json                  // TierProgressionRequirements at evaluation time
  evaluation      Json                  // RequirementStatus array
  overallProgress Int                   @default(0)

  // Shadow accounting (FOUNDER ONLY)
  actualRevenueCents    Int             @default(0)
  displayedRevenueCents Int             @default(0)

  // Review
  evaluatedAt     DateTime              @default(now())
  evaluatedBy     String                // "trainingBot" or userId

  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     String?               @db.Text

  // Outcome
  approvedAt      DateTime?
  deniedAt        DateTime?
  deniedReason    String?               @db.Text

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([fromTier])
  @@index([toTier])
}

// ============================================
// FOUNDER CONFIG — For Training Settings
// ============================================

model FounderConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           Json
  description     String?

  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([key])
}

// ============================================
// BOT RUN LOG — Track bot executions
// ============================================

model BotRunLog {
  id              String   @id @default(cuid())
  botName         String

  // Execution
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?

  // Result
  success         Boolean  @default(false)
  error           String?  @db.Text

  // Metrics
  recordsProcessed Int     @default(0)
  insightsGenerated Int    @default(0)
  alertsCreated   Int      @default(0)

  // Output
  summary         String?  @db.Text
  details         Json?

  createdAt       DateTime @default(now())

  @@index([botName])
  @@index([startedAt])
  @@index([success])
}

// ============================================
// INGESTION
// ============================================

model IngestionSource {
  id              String              @id @default(cuid())
  name            String
  type            IngestionSourceType

  // Source details
  state           String
  county          String?
  url             String?

  // Parsing config
  parserConfig    Json?               // Configuration for parsing this source

  // Schedule
  frequency       String?             // "daily", "weekly", "monthly"
  lastFetched     DateTime?
  nextFetch       DateTime?

  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  batches         IngestionBatch[]

  @@index([state])
  @@index([type])
}

model IngestionBatch {
  id              String           @id @default(cuid())
  sourceId        String
  source          IngestionSource  @relation(fields: [sourceId], references: [id])

  // File info
  fileName        String?
  fileUrl         String?

  // Processing stats
  status          String           @default("pending") // pending, processing, completed, failed
  totalRecords    Int              @default(0)
  processedRecords Int             @default(0)
  createdCases    Int              @default(0)

  // Phase 6 Intelligence stats
  recordCount     Int              @default(0)   // Total records in batch
  successCount    Int              @default(0)   // Successfully parsed/imported
  errorCount      Int              @default(0)   // Failed to parse
  highValueCount  Int              @default(0)   // High-value records detected
  duplicateCount  Int              @default(0)   // Duplicates detected

  errors          String?          @db.Text

  processedAt     DateTime?
  createdAt       DateTime         @default(now())

  records         IngestionRecord[]

  @@index([sourceId])
  @@index([status])
  @@index([createdAt])
}

model IngestionRecord {
  id              String          @id @default(cuid())
  batchId         String
  batch           IngestionBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Source type for routing to correct parser
  sourceType      String?

  // Raw data from source
  rawData         Json
  rawPayload      Json?           // Original payload before normalization

  // Normalized data (standardized fields)
  normalizedData  Json?           // { ownerName, propertyAddress, state, county, amountCents, ... }

  // Content hash for duplicate detection
  contentHash     String?

  // Legacy parsed data (kept for compatibility)
  ownerName       String?
  propertyAddress String?
  parcelNumber    String?
  saleDate        DateTime?
  saleAmount      Int?            // In cents
  surplusAmount   Int?            // In cents

  // Intelligence Layer (Phase 6)
  predictedValueCents   Int?      // Value predicted by IngestionIntelligenceService
  predictionConfidence  Float?    // 0-100 confidence score
  propertyClassCode     String?   // Links to PropertyClass.code

  // Processing
  status          String          @default("pending") // pending, processing, imported, skipped, error
  caseId          String?         // If a case was created
  errorMessage    String?
  errorDetails    String?         @db.Text  // Detailed error info for analysis

  // Founder flags
  isHighValue     Boolean         @default(false)
  priority        Int             @default(0)

  createdAt       DateTime        @default(now())

  @@index([batchId])
  @@index([status])
  @@index([isHighValue])
  @@index([contentHash])
  @@index([sourceType])
  // Performance indexes (compound for hot queries)
  @@index([status, predictedValueCents(sort: Desc)])
  @@index([isHighValue, status, createdAt(sort: Desc)])
}

// ============================================
// PARSER VERSIONING (Phase 6)
// ============================================

model ParserVersion {
  id                Int                 @id @default(autoincrement())
  sourceType        IngestionSourceType
  version           String              // "1.0", "2026-03-tax-sale-v2", etc.

  // Jurisdiction scope (null = national/generic)
  stateCode         String?
  countyFips        String?

  // Parser configuration (column mappings, regex patterns, date formats, etc.)
  parserConfig      Json                // { headerRow: number, columns: [...], dateFormat: string }

  // Performance metrics
  successRate       Float?              @default(0)
  recordsProcessed  Int                 @default(0)
  recordsFailed     Int                 @default(0)

  // Status
  isActive          Boolean             @default(true)
  notes             String?             @db.Text

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sourceType])
  @@index([stateCode])
  @@index([isActive])
}

// ============================================
// PROPERTY CLASSIFICATION (Phase 6)
// ============================================

model PropertyClass {
  id              Int       @id @default(autoincrement())
  code            String    @unique  // "RESIDENTIAL", "COMMERCIAL", "VACANT", etc.
  description     String?

  // Prediction defaults (in cents)
  defaultMinValueCents    Int?      @default(50000)    // $500 minimum
  defaultMedianValueCents Int?      @default(500000)   // $5,000 median
  defaultMaxValueCents    Int?      @default(10000000) // $100,000 max

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])

  action          String   // "CREATE", "UPDATE", "DELETE", "VIEW", "LOGIN", etc.
  entityType      String   // "Case", "Document", "User", etc.
  entityId        String?

  // Change tracking
  oldValues       Json?
  newValues       Json?
  details         Json?    // Additional context/metadata

  // Request info
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

model SystemConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   @db.Text
  description     String?

  updatedAt       DateTime @updatedAt
}

// ============================================
// OPS LAYER — SCRAPER & WATCH SYSTEM
// FOUNDER ONLY — Never expose to employees/clients
// ============================================

model ScrapedItem {
  id              String                   @id @default(cuid())
  sourceType      ScrapedItemType
  sourceUrl       String
  sourceName      String?                  // Human-readable source name

  // Location
  state           String?
  county          String?

  // Content
  rawContent      String                   @db.Text
  parsedData      Json?                    // Structured extraction
  contentHash     String?                  // For change detection

  // Review status
  reviewStatus    ScrapedItemReviewStatus  @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  notes           String?                  @db.Text

  // Metadata
  fetchedAt       DateTime                 @default(now())
  createdAt       DateTime                 @default(now())

  watchAlerts     WatchAlert[]

  @@index([sourceType])
  @@index([state])
  @@index([reviewStatus])
  @@index([fetchedAt])
}

model WatchAlert {
  id              String               @id @default(cuid())
  type            WatchAlertType
  severity        WatchAlertSeverity   @default(MEDIUM)

  // Alert content
  title           String
  message         String               @db.Text
  details         Json?                // Structured alert data

  // Location context
  state           String?
  county          String?

  // Related entities
  relatedCaseId   String?
  relatedUserId   String?
  scrapedItemId   String?
  scrapedItem     ScrapedItem?         @relation(fields: [scrapedItemId], references: [id])

  // Resolution
  isResolved      Boolean              @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?              @db.Text

  // Metadata
  createdAt       DateTime             @default(now())

  @@index([type])
  @@index([severity])
  @@index([state])
  @@index([isResolved])
  @@index([createdAt])
}

// ============================================
// OPS LAYER — PREMIUM METRICS
// Jurisdiction Volatility, Employee Integrity, Case Heatmap
// ============================================

model JurisdictionMetrics {
  id                    String   @id @default(cuid())
  state                 String
  county                String?

  // Volatility metrics
  ruleChangesLast30Days Int      @default(0)
  alertsLast30Days      Int      @default(0)
  volatilityScore       Int      @default(0)  // 0-100

  // Performance metrics
  totalCases            Int      @default(0)
  paidCases             Int      @default(0)
  rejectedCases         Int      @default(0)
  avgDaysToClose        Int?
  avgSurplusCents       Int?

  // Risk assessment
  riskScore             Int      @default(50)  // 0-100
  riskFactors           Json?

  lastCalculated        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([state, county])
  @@index([state])
  @@index([volatilityScore])
  @@index([riskScore])
}

model EmployeeIntegrityScore {
  id                    String       @id @default(cuid())
  employeeId            String       @unique
  employeeTier          EmployeeTier?

  // Training metrics
  trainingCompletionPct Int          @default(0)
  quizAvgScore          Int?

  // Performance metrics
  totalCases            Int          @default(0)
  paidCases             Int          @default(0)
  rejectedCases         Int          @default(0)
  conversionRate        Int?         // Percentage

  // Quality metrics
  avgCallScore          Int?         // 1-100
  complianceViolations  Int          @default(0)
  customerComplaints    Int          @default(0)

  // Financial metrics
  totalRevenueCents     Int          @default(0)
  avgCaseValueCents     Int?

  // Computed scores
  integrityScore        Int          @default(50)  // 0-100
  performanceScore      Int          @default(50)  // 0-100
  riskFlags             Json?

  lastCalculated        DateTime     @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([integrityScore])
  @@index([performanceScore])
}

model CaseHeatmapEntry {
  id                    String     @id @default(cuid())
  caseId                String     @unique
  internalCode          String

  // Risk factors
  valueScore            Int        @default(50)  // Based on surplus amount
  ageScore              Int        @default(50)  // Based on time in current status
  deadlineScore         Int        @default(50)  // Based on deadline proximity
  jurisdictionScore     Int        @default(50)  // Based on state/county risk

  // Computed
  overallHeatScore      Int        @default(50)  // 0-100, higher = needs attention
  heatFactors           Json?

  // Context
  currentStatus         CaseStatus
  daysInStatus          Int        @default(0)
  nearestDeadlineDays   Int?

  lastCalculated        DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([overallHeatScore])
  @@index([currentStatus])
}

model FounderFocusItem {
  id                    String   @id @default(cuid())
  priority              Int      @default(50)  // Higher = more urgent

  // Content
  title                 String
  description           String   @db.Text
  category              String   // "case", "employee", "jurisdiction", "system", "alert"

  // Related entities
  relatedCaseId         String?
  relatedUserId         String?
  relatedAlertId        String?

  // Action
  suggestedAction       String?  @db.Text
  actionUrl             String?  // Deep link in admin

  // Status
  isDismissed           Boolean  @default(false)
  dismissedAt           DateTime?
  isCompleted           Boolean  @default(false)
  completedAt           DateTime?

  // Validity
  expiresAt             DateTime?

  createdAt             DateTime @default(now())

  @@index([priority])
  @@index([category])
  @@index([isDismissed])
  @@index([isCompleted])
}

// ============================================
// SYSTEM MONITORING & NOTIFICATIONS
// Internal sovereign monitoring (no Sentry dependency)
// ============================================

enum SystemErrorSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model SystemError {
  id              String               @id @default(cuid())
  message         String
  stack           String?              @db.Text
  context         Json?                // Request context, user info, etc.
  severity        SystemErrorSeverity  @default(ERROR)

  // Source info
  source          String?              // Service/route that generated error
  endpoint        String?              // API endpoint if applicable

  // User context
  userId          String?
  ipAddress       String?
  userAgent       String?

  // Resolution
  isResolved      Boolean              @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  resolution      String?              @db.Text

  createdAt       DateTime             @default(now())

  @@index([severity])
  @@index([source])
  @@index([isResolved])
  @@index([createdAt])
}

model NotificationLog {
  id              String              @id @default(cuid())
  type            NotificationType
  status          NotificationStatus  @default(PENDING)

  // Recipient
  toAddress       String              // Email, phone, or user ID
  toName          String?

  // Content
  subject         String?
  bodyPreview     String?             // First 200 chars
  bodyFull        String?             @db.Text

  // Related entities
  relatedCaseId   String?
  relatedUserId   String?

  // Delivery info
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  errorMessage    String?

  // External refs
  externalId      String?             // ID from email provider

  createdAt       DateTime            @default(now())

  @@index([type])
  @@index([status])
  @@index([relatedCaseId])
  @@index([relatedUserId])
  @@index([createdAt])
}

// ============================================
// TRAINING MODULE DETAILS & ASSET PLANS
// AI-ready training content generation
// ============================================

enum TrainingAssetType {
  VIDEO_SCRIPT
  PDF_GUIDE
  SLIDE_DECK
  CHECKLIST
  AUDIO_SCRIPT
  QUIZ
  INTERACTIVE
}

model TrainingModuleDetail {
  id              String          @id @default(cuid())
  moduleId        String          @unique

  // Target audience
  role            UserRole?       // EMPLOYEE, FOUNDER, etc.
  tier            EmployeeTier?   // Specific tier if applicable

  // Generated content
  outline         Json?           // Structured learning outline
  scripts         Json?           // Video/audio scripts
  keyPoints       Json?           // Key learning points

  // Video blueprint
  sceneBreakdown  Json?           // Scene-by-scene breakdown
  onScreenText    Json?           // Text overlays
  bRollSuggestions Json?          // B-roll video suggestions

  // Assessment
  assessmentQuestions Json?       // Generated quiz questions

  // Metadata
  generatedAt     DateTime?
  generatedBy     String?         // "system" or userId
  version         Int             @default(1)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assetPlans      TrainingAssetPlan[]

  @@index([role])
  @@index([tier])
}

model TrainingAssetPlan {
  id              String              @id @default(cuid())
  moduleDetailId  String
  moduleDetail    TrainingModuleDetail @relation(fields: [moduleDetailId], references: [id], onDelete: Cascade)

  type            TrainingAssetType
  title           String
  description     String              @db.Text

  // Asset spec
  spec            Json?               // Detailed specifications
  duration        Int?                // Estimated duration in seconds

  // Production status
  isProduced      Boolean             @default(false)
  producedAt      DateTime?
  assetUrl        String?

  // Ordering
  orderIndex      Int                 @default(0)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([moduleDetailId])
  @@index([type])
  @@index([isProduced])
}

// ============================================
// OPS INSIGHTS — BOT OUTPUT STORAGE
// Internal bots write insights here
// ============================================

enum OpsInsightType {
  INGESTION_ANALYSIS
  PAYOUT_ANALYSIS
  COMPLIANCE_CHECK
  TRAINING_ANALYSIS
  COORDINATOR_SUMMARY
  CASE_RECOMMENDATION
  EMPLOYEE_COACHING
  SYSTEM_HEALTH
}

enum OpsInsightPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model OpsInsight {
  id              String              @id @default(cuid())
  type            OpsInsightType
  priority        OpsInsightPriority  @default(NORMAL)

  // Content
  title           String
  summary         String              @db.Text
  details         Json?               // Structured data

  // Plain-English explanation
  plainEnglish    String?             @db.Text

  // Recommendations
  recommendations Json?               // Array of suggested actions

  // Related entities
  relatedCaseIds  String[]
  relatedUserIds  String[]
  relatedAlertIds String[]

  // Source bot
  sourceBot       String              // "ingestionBot", "payoutBot", etc.
  generatedAt     DateTime            @default(now())

  // Validity
  isStale         Boolean             @default(false)
  expiresAt       DateTime?

  // Founder interaction
  isRead          Boolean             @default(false)
  readAt          DateTime?
  isActioned      Boolean             @default(false)
  actionedAt      DateTime?
  actionNotes     String?             @db.Text

  createdAt       DateTime            @default(now())

  @@index([type])
  @@index([priority])
  @@index([sourceBot])
  @@index([isRead])
  @@index([createdAt])
  // Performance indexes (compound for hot queries)
  @@index([priority, type, createdAt(sort: Desc)])
  @@index([isRead, priority, createdAt(sort: Desc)])
}

// ============================================
// INTERNAL COMMUNICATION (COMMS CHAMBER)
// ============================================

enum ChatRoomType {
  COMPANY     // All employees
  TEAM        // Team-specific
  PRIVATE     // Private/locked rooms
}

model ChatRoom {
  id          String         @id @default(cuid())
  name        String
  type        ChatRoomType   @default(TEAM)
  description String?

  // Access control
  locked      Boolean        @default(false)
  password    String?        // Hashed if locked

  // For team rooms
  teamLeaderId String?       // Team lead who owns the room

  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    ChatMessage[]

  @@index([type])
  @@index([isActive])
}

model ChatMessage {
  id          String    @id @default(cuid())
  roomId      String
  room        ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  content     String    @db.Text
  isEncrypted Boolean   @default(false)  // For air-gap mode

  // Edit tracking
  isEdited    Boolean   @default(false)
  editedAt    DateTime?

  // Soft delete
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?

  createdAt   DateTime  @default(now())

  @@index([roomId])
  @@index([userId])
  @@index([createdAt])
  @@index([roomId, createdAt(sort: Desc)])
}
