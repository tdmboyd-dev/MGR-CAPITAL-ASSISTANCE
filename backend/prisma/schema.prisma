model EmployeeIntegrityScore {
  id                    String       @id @default(cuid())
  employeeId            String       @unique
  employeeTier          EmployeeTier?

  // Training metrics
  trainingCompletionPct Int          @default(0)
  quizAvgScore          Int?

  // Performance metrics
  totalCases            Int          @default(0)
  paidCases             Int          @default(0)
  rejectedCases         Int          @default(0)
  conversionRate        Int?         // Percentage

  // Quality metrics
  avgCallScore          Int?         // 1-100
  complianceViolations  Int          @default(0)
  customerComplaints    Int          @default(0)

  // Financial metrics
  totalRevenueCents     Int          @default(0)
  avgCaseValueCents     Int?

  // Computed scores
  integrityScore        Int          @default(50)  // 0-100
  performanceScore      Int          @default(50)  // 0-100
  riskFlags             Json?

  lastCalculated        DateTime     @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([integrityScore])
  @@index([performanceScore])
}

model CaseHeatmapEntry {
  id                    String     @id @default(cuid())
  caseId                String     @unique
  internalCode          String

  // Risk factors
  valueScore            Int        @default(50)  // Based on surplus amount
  ageScore              Int        @default(50)  // Based on time in current status
  deadlineScore         Int        @default(50)  // Based on deadline proximity
  jurisdictionScore     Int        @default(50)  // Based on state/county risk

  // Computed
  overallHeatScore      Int        @default(50)  // 0-100, higher = needs attention
  heatFactors           Json?

  // Context
  currentStatus         CaseStatus
  daysInStatus          Int        @default(0)
  nearestDeadlineDays   Int?

  lastCalculated        DateTime   @default(now())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([overallHeatScore])
  @@index([currentStatus])
}

model FounderFocusItem {
  id                    String   @id @default(cuid())
  priority              Int      @default(50)  // Higher = more urgent

  // Content
  title                 String
  description           String   @db.Text
  category              String   // "case", "employee", "jurisdiction", "system", "alert"

  // Related entities
  relatedCaseId         String?
  relatedUserId         String?
  relatedAlertId        String?

  // Action
  suggestedAction       String?  @db.Text
  actionUrl             String?  // Deep link in admin

  // Status
  isDismissed           Boolean  @default(false)
  dismissedAt           DateTime?
  isCompleted           Boolean  @default(false)
  completedAt           DateTime?

  // Validity
  expiresAt             DateTime?

  createdAt             DateTime @default(now())

  @@index([priority])
  @@index([category])
  @@index([isDismissed])
  @@index([isCompleted])
}

// ============================================
// SYSTEM MONITORING & NOTIFICATIONS
