{
  "name": "mgr-capital-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "deploy:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "test:auth-boundary": "node --test tests/auth-current-boundary.test.cjs tests/transport-boundary.test.cjs",
    "test:auth-postgres": "node --import tsx tests/auth-postgres-acceptance.ts",
    "test:vault-postgres": "node --import tsx tests/vault-postgres-acceptance.ts",
    "test:vault-reopen": "node --import tsx tests/vault-reopen-acceptance.ts",
    "test:native-boundary": "node --import tsx --test tests/native-research-boundary.test.ts tests/voice-truth-boundary.test.ts",
    "test:native-postgres": "node --import tsx tests/native-research-postgres-acceptance.ts",
    "test:native-reopen": "node --import tsx tests/native-research-reopen.ts",
    "test:payment-truth": "node --import tsx tests/payment-truth-postgres.ts",
    "test:offline-privacy": "node --test tests/offline-privacy.test.cjs",
    "test:record-boundary": "node --import tsx --test tests/record-parsing-boundary.node.ts",
    "test:payout-postgres": "node --import tsx tests/payout-planning-postgres.ts",
    "test:case-creation": "node --import tsx tests/case-creation-postgres.ts",
    "test:case-workflow": "node --import tsx tests/case-workflow-postgres.ts",
    "test:case-reopen": "node --import tsx tests/case-workflow-reopen.ts",
    "test:client-portal": "node --import tsx tests/client-portal-postgres.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.983.0",
    "@aws-sdk/s3-request-presigner": "^3.983.0",
    "@prisma/client": "5.22.0",
    "@solana-program/token": "^0.18.0",
    "@solana/web3.js": "^3.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cssnano": "^8.0.10",
    "dotenv": "^16.3.1",
    "ethers": "^6.17.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.2.8",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^5.4.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.3.1",
    "openai": "^6.17.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "prisma": "5.22.0",
    "puppeteer": "^25.16.0",
    "redis": "^5.10.0",
    "ssh2": "^1.17.0",
    "stripe": "^20.2.0",
    "tsx": "^4.1.2",
    "typescript": "^5.2.2",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.23",
    "@types/jest": "^30.0.0",
    "@types/puppeteer": "^5.4.7",
    "@types/supertest": "^6.0.3",
    "cypress": "^16.2.1",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.0",
    "picomatch": "^4.0.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "qs": "^6.17.1",
    "htmlnano": {
      "cssnano": "^8.0.0"
    },
    "fdir": {
      "picomatch": "^4.0.7"
    }
  },
  "engines": {
    "node": "^22.11.0 || ^24.11.0 || >=26.0.0"
  }
}
