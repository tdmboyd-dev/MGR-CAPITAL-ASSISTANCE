# ============================================
# MGR CAPITAL ASSISTANCE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/mgr_capital?schema=public"

# ============================================
# SERVER
# ============================================
PORT=4000
WS_PORT=4001
NODE_ENV=development

# ============================================
# AUTHENTICATION — JWT
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret"
JWT_EXPIRES_IN="7d"
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=14

# ============================================
# AUTHENTICATION — Cookies
# ============================================
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ============================================
# SCHEDULER (Autopilot Crons)
# ============================================
ENABLE_SCHEDULER=true

# ============================================
# EMAIL — Brevo (Transactional)
# ============================================
BREVO_API_KEY=
BREVO_FROM=noreply@capitalmgr.com
BREVO_SENDER_EMAIL=noreply@capitalmgr.com
BREVO_SENDER_NAME="MGR Capital Assistant"

# ============================================
# EMAIL — SMTP (Generic)
# ============================================
SMTP_HOST=mail.capitalmgr.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@capitalmgr.com
SMTP_PASS=
SMTP_FROM=noreply@capitalmgr.com
SMTP_FROM_NAME="MGR Capital Assistant"

# ============================================
# EMAIL — Modoboa (Self-hosted)
# ============================================
MODOBOA_API_URL=https://mail.capitalmgr.com/api/v1
MODOBOA_API_KEY=
MODOBOA_API_TOKEN=
MODOBOA_DOMAIN=capitalmgr.com
MODOBOA_SMTP_HOST=mail.capitalmgr.com
MODOBOA_SMTP_PORT=587
MODOBOA_SMTP_SECURE=false
MODOBOA_SMTP_USER=noreply@capitalmgr.com
MODOBOA_SMTP_PASS=
MODOBOA_ADMIN_EMAIL=admin@capitalmgr.com
MODOBOA_SUPPORT_EMAIL=support@capitalmgr.com
MODOBOA_NOREPLY_EMAIL=noreply@capitalmgr.com
MAIL_SERVER_HOSTNAME=mail.capitalmgr.com
MAIL_SERVER_IP=

# ============================================
# SMS — Plivo (for text messaging)
# ============================================
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SENDER_NUMBER=

# ============================================
# SKIP TRACE — Tracerfy
# ============================================
TRACERFY_API_KEY=
TRACERFY_API_URL=https://tracerfy.com/v1/api

# ============================================
# PHONE — Telnyx (for voice calls)
# ============================================
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=

# ============================================
# AI — OpenAI (Cloud)
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# AI — Ollama (Local - for development only)
# ============================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ============================================
# AI — DeepSeek (Cloud - 95% cheaper than OpenAI)
# ============================================
DEEPSEEK_API_KEY=

# ============================================
# AI — Google Gemini (Cloud)
# ============================================
GOOGLE_AI_KEY=

# ============================================
# AI — Deepgram (Speech-to-Text - best value)
# ============================================
DEEPGRAM_API_KEY=

# ============================================
# AI — Billing
# ============================================
AI_MARKUP_PERCENT=20

# ============================================
# PAYMENTS — Nickel (Complete Payment Platform)
# Sign up: https://getnickel.com
# Features: FREE ACH, Cards (2.9%), Bill Pay, Invoicing, Net Terms
# ============================================
NICKEL_API_KEY=
NICKEL_API_URL=https://api.getnickel.com/v1
NICKEL_WEBHOOK_SECRET=
NICKEL_ENVIRONMENT=sandbox

# ============================================
# PAYMENTS — Stripe
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# BLOCKCHAIN — Ethereum (Optional)
# ============================================
ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC_URL=
ETHEREUM_WALLET_ADDRESS=
ETHEREUM_PRIVATE_KEY=
NFT_CONTRACT_ADDRESS=

# ============================================
# BLOCKCHAIN — Solana (Optional)
# ============================================
SOLANA_RPC_URL=https://api.devnet.solana.com

# ============================================
# DOCUMENT SIGNING — OpenSign (FREE unlimited)
# ============================================
OPENSIGN_API_KEY=
OPENSIGN_JWT=

# ============================================
# NOTARY — Founder Credentials (Timebeunus Boyd)
# Tennessee does not issue commission numbers
# ============================================
NOTARY_NAME="Timebeunus Boyd"
NOTARY_COMMISSION_NUMBER=
NOTARY_STATE=TN
NOTARY_COUNTY=Shelby
NOTARY_EXPIRATION_DATE=2029-04-17
NOTARY_BOND_COMPANY="Travelers Casualty and Surety Company of America"
NOTARY_BOND_POLICY_NUMBER=108173467-211
NOTARY_BOND_EFFECTIVE_DATE=2025-05-09
NOTARY_BOND_LIABILITY_LIMIT=10000

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=./uploads
GENERATED_DOCS_DIR=./generated-documents
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_FILE_SIZE_MB=50

# ============================================
# BACKUP & VAULT
# ============================================
BACKUP_DIR=./backups
VAULT_DIR=./vault
BACKUP_PASSPHRASE=
OFFSITE_BACKUP_PATH=

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3011

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3

# ============================================
# CACHING — Redis (Optional)
# ============================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL=3600

# ============================================
# DATABASE PERFORMANCE
# ============================================
BATCH_SIZE_LIMIT=1000
QUERY_TIMEOUT_MS=30000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ============================================
# EXTERNAL SERVICES — URLs
# ============================================
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api
FOUNDER_EMAIL=admin@capitalmgr.com

# ============================================
# DEMO / SPECIAL MODES
# ============================================
DEMO_MODE=false
AIR_GAP_MODE=false
