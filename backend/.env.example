# ============================================
# MGR CAPITAL ASSISTANCE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/mgr_capital?schema=public"

# ============================================
# SERVER
# ============================================
PORT=3001
WS_PORT=4001
NODE_ENV=development

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ============================================
# SCHEDULER (Autopilot Crons)
# ============================================
ENABLE_SCHEDULER=true

# ============================================
# EMAIL — Brevo (Transactional)
# ============================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@mgrcapital.com
BREVO_SENDER_NAME="MGR Capital Assistance"

# ============================================
# EMAIL — Modoboa (Self-hosted)
# ============================================
MODOBOA_API_URL=https://mail.yourdomain.com/api/v1
MODOBOA_API_KEY=
MODOBOA_DOMAIN=mgrcapital.com

# ============================================
# SMS — Plivo
# ============================================
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SENDER_NUMBER=+1XXXXXXXXXX

# ============================================
# SKIP TRACE — Tracerfy
# ============================================
TRACERFY_API_KEY=
TRACERFY_API_URL=https://api.tracerfy.com/v1

# ============================================
# PHONE — Telnyx (Primary)
# ============================================
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_MESSAGING_PROFILE_ID=

# ============================================
# PHONE — Twilio (Backup)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ============================================
# AI — OpenAI
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# VOICE — ElevenLabs
# ============================================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ============================================
# PAYMENTS — Nickel (ACH)
# ============================================
NICKEL_API_KEY=
NICKEL_ENVIRONMENT=sandbox

# ============================================
# BLOCKCHAIN — Ethereum
# ============================================
ETH_NETWORK=mainnet
ETH_PRIVATE_KEY=
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
NFT_CONTRACT_ADDRESS=

# ============================================
# DOCUMENT SIGNING — DocuSign (Optional)
# ============================================
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# ============================================
# NOTARY — Founder Credentials
# ============================================
NOTARY_NAME="Your Full Name"
NOTARY_COMMISSION_NUMBER=
NOTARY_STATE=TN
NOTARY_COUNTY=Shelby
NOTARY_EXPIRATION_DATE=2028-12-31

# ============================================
# FILE STORAGE
# ============================================
UPLOAD_DIR=./uploads
GENERATED_DOCS_DIR=./generated-documents
MAX_FILE_SIZE_MB=50

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3011

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=3

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret

# ============================================
# EXTERNAL SERVICES — URLs
# ============================================
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001/api

# ============================================
# DEMO MODE (Set to true for testing without real API calls)
# ============================================
DEMO_MODE=false
